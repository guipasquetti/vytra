{
  "expo": {
    "name": "Vytra",
    "slug": "app-treino",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/vytra-app-icon-1024.png",
    "scheme": "vytra",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0A0C0D",
    "primaryColor": "#2ED9A3",
    "ios": {
      "icon": "./assets/brand/vytra-app-icon-1024.png"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0C0D",
        "foregroundImage": "./assets/brand/vytra-icon-foreground-1024.png",
        "monochromeImage": "./assets/brand/vytra-icon-monochrome-1024.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/brand/vytra-favicon-196.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A0C0D",
          "image": "./assets/brand/vytra-splash-512.png",
          "imageWidth": 140
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "A Vytra usa a câmera pra você tirar as fotos de progresso do check-in, sempre no mesmo enquadramento."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "A Vytra acessa suas fotos pra você enviar uma foto já tirada no check-in ou um documento de exame."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "A Vytra usa Face ID pra travar o app e proteger seus dados de saúde."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f37244c8-045f-4fff-89de-ecf05f7872ce"
      }
    },
    "owner": "guipasquetti"
  }
}
